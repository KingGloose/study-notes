# Python 虚拟环境（统一放 skills/.venv，不进版本库）
.venv/
**/.venv/

# 敏感凭证（各 skill 的 .env，如 B 站 SESSDATA）
.env
**/.env

# Python 缓存与构建产物
__pycache__/
**/__pycache__/
*.pyc
*.pyo
*.egg-info/
**/*.egg-info/
build/
dist/

# 运行时临时产物
qrcode.png
.DS_Store
**/.DS_Store

# agent 运行时目录
.pi-subagents/
.vault-index.json
.review-log.json
